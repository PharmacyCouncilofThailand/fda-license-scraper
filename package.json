{
  "name": "fda-license-scraper",
  "version": "1.0.0",
  "description": "Backend API for scraping FDA (อย.) drug establishment license search",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "install:web": "npm --prefix web install",
    "smoke": "node smoke-form.js",
    "smoke:api": "node smoke.js",
    "test": "node test-thai-name.js && node test-route.js && node test-plans-store.js && node test-plans.js && node test-records-store.js && node test-form-fields.js && node test-docx-plan.js && node test-parse.js && node test-form-parity.js && node test-rate-limit.js",
    "test:parse": "node test-parse.js",
    "test:name": "node test-thai-name.js",
    "test:plans-store": "node test-plans-store.js",
    "test:plans": "node test-plans.js",
    "test:records": "node test-records-store.js",
    "test:fields": "node test-form-fields.js",
    "test:parity": "node test-form-parity.js",
    "test:docx": "node test-docx-pad.js",
    "test:docx-plan": "node test-docx-plan.js",
    "smoke:pharmacist": "node smoke-pharmacist.js"
  },
  "dependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "@vercel/blob": "^2.8.0",
    "express": "^4.19.2",
    "puppeteer": "^25.8.0",
    "puppeteer-core": "^25.8.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
