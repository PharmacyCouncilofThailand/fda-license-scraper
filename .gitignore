node_modules/

# Build output. The sources live in web/ — run `npm run build` to recreate this.
# Anchored: web/public/ is source, and holds form.html, theme.css and the logo.
/public/

# Local overrides
.env
.env.local

*.log
npm-debug.log*

# Official documents stay out of the repo: the Word template carries the
# inspecting officers' real names, and the deploy pulls it in separately.
# See "Deploying" in the README.
templates/
scripts/logo-source.jpg

# Licensed office fonts for the PDF, if they are used — see "Deploying".
# Anchored: assets/fonts/ holds Sarabun, which is Open Font Licensed and has
# to ship, and an unanchored rule quietly swallowed it.
/fonts/

.vercel

# Inspection plans, records and photos written by the `file` backend during
# local runs.
/data/

# SDD scratch: ledgers, briefs, review packages. Not the record — git is.
.superpowers/
