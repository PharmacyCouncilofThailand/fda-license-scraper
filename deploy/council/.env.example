# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# The port people open in the browser: http://<this machine>:APP_PORT
APP_PORT=80

# The office passcode for plans and the drive. Required: on a LAN without it,
# any web page a staff member visits could read the API through their browser.
PLANS_PASSCODE=

# The NAS, reached over SMB from this machine only.
NAS_HOST=192.168.1.10
# The share for the ไดรฟ์ page — staff can open the same folder from Windows.
NAS_DRIVE_SHARE=fda-drive
# The share for the app's own plans, records and photos. Keep staff out of it.
NAS_APP_SHARE=fda-app-data
# A NAS account that can read and write only those two shares.
NAS_USER=
NAS_PASSWORD=
# Lower to 2.1 only if the NAS refuses 3.0.
NAS_SMB_VERSION=3.0

# Sign-in through the Pharmacy Council (see README "เข้าสู่ระบบผ่านสภา").
# passcode = office passcode (now). header = the Council gateway signs people
# in and forwards their username in AUTH_USER_HEADER.
AUTH_MODE=passcode
AUTH_USER_HEADER=x-remote-user
# A long random value the gateway adds as x-auth-proxy-secret on every request.
AUTH_PROXY_SECRET=
# 1 when a reverse proxy / gateway sits in front of the app, else 0.
TRUST_PROXY=0

# The upload parts — ไดรฟ์, เอกสาร (scanned forms per shop) and ภาพรวม — are
# held back for a later update. Leave 0 until that update is released.
FEATURE_DOCS=0
